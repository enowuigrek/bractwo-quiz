# Skopiuj do .env.local i uzupełnij. Na Vercelu te same zmienne w ustawieniach projektu.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://yyacqskrpgnfdxtcmapw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Klucz sekretny (omija RLS). Tylko serwer, nigdy z prefiksem NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Od 30.10 panel ma konta osobowe (e-mail i hasło w tabeli `konta`). To hasło jest awaryjnym wejściem na konto
# z rolą twórcy (Łukasz): działa z jego e-mailem, gdy nie ustawił jeszcze własnego hasła albo je zgubił.
ADMIN_HASLO_GLOWNE=
# Losowy ciąg do podpisywania ciasteczka admina, np. `openssl rand -base64 48`
ADMIN_SEKRET=

# Vercel Cron wysyła go w nagłówku do /api/keepalive. Losowy ciąg, np. `openssl rand -hex 32`.
# Lokalnie można zostawić puste (wtedy endpoint jest otwarty).
CRON_SECRET=

# Opcjonalnie: stały adres aplikacji do linków i QR (bez ukośnika na końcu).
# Bez niego adres bierzemy z bieżącego żądania.
NEXT_PUBLIC_SITE_URL=

# OpenAI: tylko lokalnie, skrypt grafik (`node --env-file=.env.local scripts/grafiki.mjs`). Aplikacja go nie używa
# (przeróbka zdjęć nagród wyłączona 25.10), więc na Vercelu jest niepotrzebny.
OPENAI_API_KEY=
